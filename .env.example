# Optional server-side secret. Never prefix this with VITE_ or expose it to the
# browser. In Vercel, set this in Project Settings → Environment Variables.
# Leave it unset to use Relay's deterministic offline fallback.
ANTHROPIC_API_KEY=
# Optional server-side model override. It must support the Anthropic Messages API.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
